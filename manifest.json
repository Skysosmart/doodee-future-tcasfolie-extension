{
  "manifest_version": 3,
  "name": "Doodee future",
  "version": "1.0",
  "description": "คลังเก็บข้อมูลผลงานจากเล่ม portfolio เดิม สำหรับกรอก TCASFolio",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doodee future",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.mytcas.com/*"
      ],
      "js": [
        "model.js",
        "storage.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "inject.js"
      ],
      "matches": [
        "https://student.mytcas.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
