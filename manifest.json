{
  "manifest_version": 3,
  "name": "Doodee future",
  "version": "1.0",
  "description": "คลังเก็บข้อมูลผลงานจากเล่ม portfolio เดิม สำหรับกรอก TCASFolio",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://doodee-future.com/*",
    "https://tcas65.as.r.appspot.com/*",
    "https://tcas70.s3.ap-southeast-1.amazonaws.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doodee future",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.mytcas.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://student.mytcas.com/*"
      ],
      "js": [
        "model.js",
        "storage.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://doodee-future.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "inject.js",
        "interceptor.js"
      ],
      "matches": [
        "https://student.mytcas.com/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
